# Copy to .env for local development. Never commit real secrets.
# ---------------------------------------------------------------------------

# Application
APP_NAME=AgentHU
ENVIRONMENT=local
DEBUG=false
LOG_LEVEL=INFO

# PostgreSQL (SQLAlchemy URL, psycopg3 driver)
# Use 127.0.0.1 rather than "localhost" on Windows to avoid IPv6 (::1) resolution.
DATABASE_URL=postgresql+psycopg://agenthu:agenthu@127.0.0.1:5432/agenthu
# Used by the test suite (separate database).
TEST_DATABASE_URL=postgresql+psycopg://agenthu:agenthu@127.0.0.1:5432/agenthu_test
DB_ECHO=false

# Redis / Arq
REDIS_URL=redis://127.0.0.1:6379/0

# Auth (CHANGE THIS OUTSIDE LOCAL DEV)
SECRET_KEY=dev-insecure-change-me
ACCESS_TOKEN_EXPIRE_MINUTES=10080
JWT_ALGORITHM=HS256

# Object storage
STORAGE_BACKEND=minio
S3_ENDPOINT_URL=http://127.0.0.1:9000
S3_ACCESS_KEY=agenthu
S3_SECRET_KEY=agenthu123
S3_BUCKET=agenthu
S3_REGION=us-east-1
S3_USE_SSL=false
SIGNED_URL_EXPIRE_SECONDS=3600
MAX_UPLOAD_BYTES=52428800

# CORS (comma separated in .env, JSON list also accepted)
CORS_ORIGINS=["*"]
