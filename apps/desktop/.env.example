# Backend API origin. Leave empty to run the campus collection UI without
# Backend-backed tasks, plans, Focus, or Event synchronization.
#
# The packaged Tauri app allows the local development origins below and HTTPS
# origins in its CSP. If you use another plain-HTTP host or port, update
# apps/desktop/src-tauri/tauri.conf.json before building the package.
VITE_BACKEND_URL=http://127.0.0.1:8000
