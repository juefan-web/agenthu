# Backend API origin. Leave empty to run the campus collection UI without
# Backend-backed tasks, plans, Focus, or Event synchronization.
#
# The packaged Tauri app only allows the local development origins below in
# its CSP. For any other Backend host (including HTTPS origins), add the
# origin to the connect-src list in apps/desktop/src-tauri/tauri.conf.json
# before building the package; `pnpm build` fails until it is allowlisted.
VITE_BACKEND_URL=http://127.0.0.1:8000
