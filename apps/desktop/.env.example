# Backend API origin. Leave empty to run the campus collection UI without
# Backend-backed tasks, plans, Focus, or Event synchronization.
#
# This is the BUILD-TIME default only (B-4): packaged Backend traffic goes
# through the `backend_request` Tauri command (Rust-side allowlist; https for
# non-local origins, http allowed for 127.0.0.1/localhost). Switching the
# Backend at runtime needs no rebuild — edit "Backend 地址" in the app's
# login panel and it is registered into the Rust allowlist after validation.
# Browser-mode dev keeps direct fetch via devCsp origins.
VITE_BACKEND_URL=http://127.0.0.1:8000

# Campus transport diagnostics, default off. Set to 1 (build time), or run
# localStorage.setItem("agenthu.campus-debug", "1") in DevTools and reload,
# to mirror the vendored LEARN-SILENT/INFO debug lines into the console.
# Lines contain cookie names and truncated URLs only, never values.
VITE_CAMPUS_DEBUG=0
