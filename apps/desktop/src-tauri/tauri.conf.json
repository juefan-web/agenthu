{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Agenthu",
  "version": "0.1.0",
  "identifier": "dev.agenthu.desktop",
  "build": {
    "beforeDevCommand": "pnpm --filter @agenthu/desktop dev",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Agenthu",
        "width": 1280,
        "height": 840,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' https: http://localhost:5173; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-eval'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all"
  }
}
